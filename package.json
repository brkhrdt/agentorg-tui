{
  "name": "org-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal client for the Agent Organization Server",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "bench:probe": "tsx scripts/bench-probe.ts",
    "build": "node scripts/build.mjs",
    "test:binary": "npm run build && node scripts/test-binary-relocation.mjs && ORG_TUI_BINARY=./dist/org-tui vitest run tests/ui.test.ts tests/rendering.test.ts tests/layout-ui.test.ts tests/prompt-ui.test.ts tests/compose-drafts-ui.test.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^24.0.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
